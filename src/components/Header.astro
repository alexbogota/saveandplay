---
const path = Astro.url.pathname;
const isHome = path === '/';

// On the home page the menu jumps to sections; on other pages it links to pages.
const links = isHome
  ? [
      { href: '#deals', label: 'Deals' },
      { href: '#stores', label: 'Stores' },
      { href: '#how', label: 'How it works' },
      { href: '/deals/', label: 'All deals' },
      { href: '/servers/', label: 'Servers' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/deals/', label: 'Deals' },
      { href: '/servers/', label: 'Servers' },
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
    ];
---
<header>
  <div class="container bar">
    <a href="/" class="logo" aria-label="SaveAndPlay home">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#3DDC97"></rect><path d="M12 9.5v13l11-6.5z" fill="#06150E"></path></svg>
      <span>SaveAndPlay</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a class="sp-link" href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme">
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const label = () => {
    button?.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  };
  label();
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F6F8FA' : '#0D1117');
    try { localStorage.setItem('sp-theme', next); } catch {}
    label();
  });
</script>

<style>
  header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 32px; padding-top: 8px; padding-bottom: 8px; }
  .logo { display: flex; align-items: center; gap: 10px; min-height: 44px; }
  .logo span { font-family: var(--font-head); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--heading); }
  nav { display: flex; flex-wrap: wrap; gap: 0 24px; font-weight: 500; font-size: 15px; color: var(--body-muted); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; }
  nav a[aria-current='page'] { color: var(--heading); }
  .theme-toggle { margin-left: auto; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--border-strong); border-radius: 10px; background: var(--panel); color: var(--body-muted); cursor: pointer; }
  .theme-toggle:hover { color: var(--heading); border-color: var(--border-hover); }
  .icon-moon { display: none; }
  /* Phone: logo and button on the first row, the menu below. */
  @media (max-width: 640px) {
    .logo { order: 1; }
    .theme-toggle { order: 2; }
    nav { order: 3; flex-basis: 100%; }
  }
  :global(:root[data-theme='light']) .icon-sun { display: none; }
  :global(:root[data-theme='light']) .icon-moon { display: block; }
</style>
