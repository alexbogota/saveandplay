---
import { site } from '../lib/site';
---
{site.analyticsId && (
  <div class="consent" id="consent" role="region" aria-label="Analytics cookies" hidden>
    <p>We use Google Analytics cookies to count visits and see which deals are useful. Nothing is used for ads. <a class="text-link" href="/privacy/">Privacy policy</a></p>
    <div class="actions">
      <button type="button" class="btn sp-btn" data-consent="granted">Accept</button>
      <button type="button" class="btn btn-ghost sp-btn" data-consent="denied">Decline</button>
    </div>
  </div>
)}

<script>
  const box = document.getElementById('consent');
  if (box) {
    const gtag = (...args: unknown[]) => (window as any).gtag?.(...args);
    const read = () => { try { return localStorage.getItem('sp-consent'); } catch { return null; } };

    // Remove Google Analytics cookies when someone says no.
    const clearAnalyticsCookies = () => {
      document.cookie.split(';').forEach((c) => {
        const name = c.split('=')[0].trim();
        if (name === '_ga' || name.startsWith('_ga_')) {
          const gone = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
          document.cookie = gone;
          document.cookie = `${gone}; domain=.${location.hostname}`;
        }
      });
    };

    const choose = (value: 'granted' | 'denied') => {
      try { localStorage.setItem('sp-consent', value); } catch {}
      gtag('consent', 'update', { analytics_storage: value });
      if (value === 'denied') clearAnalyticsCookies();
      box.hidden = true;
    };

    box.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => choose(b.dataset.consent as 'granted' | 'denied')),
    );
    // "Cookie settings" link in the footer opens the banner again.
    document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', () => { box.hidden = false; }));

    if (!read()) box.hidden = false;
  }
</script>

<style>
  .consent {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50;
    max-width: 760px; margin: 0 auto; padding: 16px 20px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; justify-content: space-between;
    background: var(--panel); border: 1px solid var(--border-strong); border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  .consent[hidden] { display: none; }
  p { margin: 0; flex: 1 1 320px; font-size: 14px; line-height: 1.5; color: var(--body-muted); }
  .actions { display: flex; gap: 10px; }
  .actions .btn { min-height: 44px; }
</style>
