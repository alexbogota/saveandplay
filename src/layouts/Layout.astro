---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Link preview card. Without these, the card uses the site title and the one site-wide picture.
  ogTitle?: string;
  ogImage?: string; // full address of the picture
  ogImageAlt?: string;
}
const { title, description, noindex = false, ogTitle, ogImage: ogImageUrl, ogImageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link preview card (Bluesky, Mastodon and others read these tags). Default picture for all pages: public/og-image.png, 1200x630.
// A page with its own picture (a game page) passes ogImage; its size is not known, so no width/height tags are written.
const ogImage = ogImageUrl ?? new URL('/og-image.png', Astro.site).href;
const ogAlt = ogImageUrl ? ogImageAlt : 'SaveAndPlay: Save on the games. Play more of them.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SaveAndPlay" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!ogImageUrl && <meta property="og:image:width" content="1200" />}
    {!ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0D1117" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('sp-theme');
          if (t !== 'light' && t !== 'dark') t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#F6F8FA' : '#0D1117';
        } catch (e) {}
      })();
    </script>
    <meta name="mitgo-verification" content="5aa3e869-8925-47d5-bd66-f6dae0096ded" />
    <link rel="me" href="https://mastodon.social/@saveandplay" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ConsentBanner />
  </body>
</html>
