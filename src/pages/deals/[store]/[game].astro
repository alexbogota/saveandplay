---
import Layout from '../../../layouts/Layout.astro';
import { dealPages, dealPath, goUrl, money, slug } from '../../../lib/deals';

// One page per offer in data/deals.json: /deals/<store>/<game>/. Mostly there so a link in a social post shows
// the game's title and cover in its preview card.
export function getStaticPaths() {
  return dealPages.map((deal) => ({ params: { store: slug(deal.store), game: slug(deal.title) }, props: { deal } }));
}

const { deal } = Astro.props;
const when = (iso?: string) =>
  iso
    ? new Date(iso).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' })
    : undefined;
const checked = when(deal.updatedAt);
const ends = when(deal.endsAt);

const heading = `${deal.title} deal at ${deal.store}`;
const description = `${deal.title} is on sale at ${deal.store}, ${deal.discount}% off. See the current price and when we last checked it.`;
const cover = deal.cover;
const coverAlt = `Cover art for ${deal.title}`;
const buy = deal.affiliateUrl ?? deal.url ?? goUrl(deal);
---
<Layout title={`${heading} | SaveAndPlay`} description={description} ogTitle={heading} ogImage={cover} ogImageAlt={cover ? coverAlt : undefined}>
  <main class="page deal">
    <div class="eyebrow"><a href="/deals/">All deals</a></div>
    <div class="cover" style={cover ? undefined : `background: ${deal.tone}`}>
      {cover && <img src={cover} alt={coverAlt} width="460" height="215" />}
      <span class="off">-{deal.discount}%</span>
    </div>
    <h1>{deal.title}</h1>
    <p class="store">{deal.store}</p>

    <div class="row">
      <div class="prices">
        <div class="was">{money(deal.was)}</div>
        <div class="now">{money(deal.price)}</div>
      </div>
      <a class="sp-btn view" href={buy} rel="sponsored nofollow noopener" target="_blank" data-deal={deal.title} data-store={deal.store} aria-label={`View deal: ${deal.title} at ${deal.store}`}>View deal</a>
    </div>

    <ul class="facts">
      {checked && <li>Price checked: <time datetime={deal.updatedAt}>{checked}</time></li>}
      {ends && <li>Sale ends: <time datetime={deal.endsAt} id="ends">{ends}</time></li>}
    </ul>
    <p class="ended" id="ended" hidden>This sale may already be over. Check the price in the store before you buy.</p>

    <p class="note">Prices change often and can be out of date by the time you click. Always check the final price in the store. Some links are affiliate links: we may earn a commission when you buy, at no extra cost to you. <a href="/disclosure/">Learn more</a></p>
    <p class="more"><a class="text-link" href={`/deals/?store=${slug(deal.store)}`}>More {deal.store} deals</a></p>
  </main>
</Layout>

<script>
  // The page is built once a day, so a sale can end after the build: say so.
  const ends = document.getElementById('ends')?.getAttribute('datetime');
  if (ends && Date.parse(ends) < Date.now()) document.getElementById('ended')!.hidden = false;
</script>

<style>
  .deal { max-width: 640px; }
  .eyebrow a { color: inherit; }
  .cover { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); background: #1C2430; aspect-ratio: 460 / 215; margin-bottom: 24px; }
  .cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .off { position: absolute; top: 12px; left: 12px; padding: 4px 9px; border-radius: 6px; background: var(--badge); color: var(--on-badge); font-weight: 700; font-size: 14px; }
  .store { font-size: 16px; color: var(--muted); margin: -4px 0 24px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .prices { line-height: 1.2; }
  .was { font-size: 15px; color: var(--muted); text-decoration: line-through; }
  .now { font-weight: 700; font-size: 32px; color: var(--heading); }
  .view { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; border-radius: 10px; background: var(--accent); color: var(--on-accent); font-weight: 700; font-size: 16px; }
  .facts { list-style: none; padding: 0; margin: 0 0 16px; color: var(--body-muted); font-size: 15px; display: grid; gap: 4px; }
  .ended { padding: 12px 16px; border: 1px solid var(--callout-border); border-radius: 10px; background: var(--callout-bg); color: var(--callout-text); }
  .ended[hidden] { display: none; }
  .note { font-size: 14px; color: var(--muted); }
  .more { margin-top: 24px; }
</style>
