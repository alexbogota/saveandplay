---
import Layout from '../../layouts/Layout.astro';

const guides = [
  { href: '/guides/real-vs-fake-game-discounts/', title: 'How to tell a real game discount from a fake one', text: 'What the official Steam and EU rules say about sale prices, and five questions to ask before you buy.' },
];
---
<Layout
  title="Guides: buy PC games smarter | SaveAndPlay"
  description="Plain guides for buying PC games: how to spot a fake discount, what a sale price really means, and what to check before you pay."
>
  <main class="page">
    <div class="eyebrow">Guides</div>
    <h1>Buy PC games smarter</h1>
    <p class="intro">Short, plain guides that help you get more games for your money. No hype, and where we use numbers or rules we name the source.</p>

    <h2>All guides</h2>
    <div class="guides">
      {guides.map((g) => (
        <a class="guide" href={g.href}>
          <h3>{g.title}</h3>
          <p>{g.text}</p>
          <span class="more">Read the guide →</span>
        </a>
      ))}
    </div>

    <h2>Looking for something else?</h2>
    <p>See the <a class="text-link" href="/deals/">current deals</a>, or read our guides to <a class="text-link" href="/servers/">game servers</a> if you want to play with friends.</p>
  </main>
</Layout>

<style>
  .intro { font-size: 18px; }
  .guides { display: grid; gap: 16px; margin: 0 0 8px; }
  .guide { display: block; padding: 20px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; }
  .guide:hover { border-color: var(--border-hover); }
  .guide h3 { margin: 0 0 6px; font-family: var(--font-head); font-weight: 600; font-size: 20px; color: var(--heading); }
  .guide p { margin: 0 0 10px; font-size: 15px; color: var(--body-muted); }
  .more { font-size: 14px; font-weight: 700; color: var(--accent-text); }
</style>
